# ---- Server ----
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# ---- Database ----
# Leave empty for local development (uses built-in SQLite file ./data/skywings.db).
# On Render, set to your Postgres connection string (render.yaml wires this automatically).
DATABASE_URL=

# ---- Flights (Duffel) ----
# Get a key at https://duffel.com — required for LIVE flight search.
# Without it, /api/flights/search returns 503 (no fake results are ever shown).
DUFFEL_API_KEY=

# ---- Uploads ----
UPLOAD_DIR=uploads
